+import { DndContext, closestCenter, type DragEndEvent } from "@dnd-kit/core";
+import { SortableContext, arrayMove, useSortable, verticalListSortingStrategy } from "@dnd-kit/sortable";
+import { CSS } from "@dnd-kit/utilities";
+import { GripVertical } from "lucide-react";
+import { useState } from "react";
 import { Link } from "react-router";
-import type { Favorite } from "../api/favorites";
+import { saveFavoriteOrder, type Favorite } from "../api/favorites";

-export function FavoritesSidebar({ favorites }: { favorites: Favorite[] }) {
+export function FavoritesSidebar({ favorites: initial }: { favorites: Favorite[] }) {
+  const [favorites, setFavorites] = useState(initial);
+
+  function handleDragEnd({ active, over }: DragEndEvent) {
+    if (!over || active.id === over.id) return;
+    const from = favorites.findIndex((favorite) => favorite.id === active.id);
+    const to = favorites.findIndex((favorite) => favorite.id === over.id);
+    const next = arrayMove(favorites, from, to);
+    setFavorites(next);
+    void saveFavoriteOrder(next.map((favorite) => favorite.id));
+  }
+
   return (
     <nav aria-label="Favorites" className="flex flex-col gap-1 p-3">
       <h2 className="px-2 text-xs font-semibold uppercase text-gray-500">Favorites</h2>
-      <ul>
-        {favorites.map((favorite) => (
-          <li key={favorite.id}>
-            <Link to={favorite.href} className="block rounded px-2 py-1.5 text-sm hover:bg-gray-100">
-              {favorite.label}
-            </Link>
-          </li>
-        ))}
-      </ul>
+      <DndContext collisionDetection={closestCenter} onDragEnd={handleDragEnd}>
+        <SortableContext items={favorites} strategy={verticalListSortingStrategy}>
+          <ul>
+            {favorites.map((favorite) => (
+              <SortableFavorite key={favorite.id} favorite={favorite} />
+            ))}
+          </ul>
+        </SortableContext>
+      </DndContext>
     </nav>
   );
 }
+
+function SortableFavorite({ favorite }: { favorite: Favorite }) {
+  const { attributes, listeners, setNodeRef, transform, transition, isDragging } = useSortable({ id: favorite.id });
+  return (
+    <li
+      ref={setNodeRef}
+      style={{ transform: CSS.Transform.toString(transform), transition }}
+      className={isDragging ? "relative z-10 rounded bg-white shadow-md" : undefined}
+    >
+      <div className="group flex items-center gap-1">
+        <button
+          type="button"
+          aria-label={`Reorder ${favorite.label}`}
+          className="cursor-grab rounded p-1 text-gray-400 opacity-0 group-hover:opacity-100 focus-visible:opacity-100"
+          {...attributes}
+          {...listeners}
+        >
+          <GripVertical className="size-4" />
+        </button>
+        <Link to={favorite.href} className="block flex-1 rounded px-2 py-1.5 text-sm hover:bg-gray-100">
+          {favorite.label}
+        </Link>
+      </div>
+    </li>
+  );
+}
