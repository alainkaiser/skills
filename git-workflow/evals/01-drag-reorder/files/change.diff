   return response.json();
 }
+
+export async function saveFavoriteOrder(ids: string[]): Promise<void> {
+  await fetch("/api/favorites/order", {
+    method: "PUT",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ ids }),
+  });
+}
